{
  "extends": ["stylelint-config-standard-scss"],
  "rules": {
    "no-empty-source": null
  },
  "overrides": [
    {
      "files": ["libs/ng-components/**/*.scss"],
      "rules": {
        "color-no-hex": true,
        "color-named": "never",
        "function-disallowed-list": [
          "rgb",
          "rgba",
          "hsl",
          "hsla",
          "hwb",
          "lab",
          "lch",
          "oklab",
          "oklch",
          "color",
          "light-dark"
        ]
      }
    },
    {
      "files": ["libs/ng-components/core/src/styles/**/*.scss"],
      "rules": {
        "color-no-hex": null,
        "color-named": null,
        "function-disallowed-list": null
      }
    }
  ]
}
