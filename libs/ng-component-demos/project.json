{
  "name": "ng-component-demos",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ng-component-demos/src",
  "prefix": "ngc-demo",
  "projectType": "library",
  "tags": ["type:demos"],
  "targets": {
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "test": {
      "dependsOn": ["generate-snippets"]
    },
    "typecheck": {
      "dependsOn": ["generate-snippets"]
    },
    "generate-snippets": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/lib/**/examples/*.example.ts",
        "{projectRoot}/src/lib/**/examples/*.example.html",
        "{projectRoot}/tools/generate-snippets.mjs",
        {
          "externalDependencies": ["shiki"]
        }
      ],
      "outputs": ["{projectRoot}/src/lib/**/*.snippet.ts"],
      "options": {
        "command": "node libs/ng-component-demos/tools/generate-snippets.mjs"
      }
    }
  }
}
