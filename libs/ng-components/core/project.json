{
  "name": "core",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ng-components/core/src",
  "prefix": "ngc",
  "projectType": "library",
  "tags": ["type:components"],
  "targets": {
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "check-contrast": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/src/styles/_theme-*.scss", "{projectRoot}/tools/check-contrast.mjs"],
      "options": {
        "command": "node libs/ng-components/core/tools/check-contrast.mjs"
      }
    }
  }
}
