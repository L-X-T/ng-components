{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@agentic-software/ng-components/core": ["./libs/ng-components/core/src/index.ts"],
      "@ngc-internal/tools": ["./tools/ngc/src/index.ts"],
      "@ngc-internal/demos": ["./libs/ng-component-demos/src/index.ts"],
      "@ngc-internal/demos/manifest": ["./libs/ng-component-demos/src/lib/_manifest/index.ts"],
      "@ngc-internal/demos/loaders": ["./libs/ng-component-demos/src/lib/_loaders/index.ts"],
      "@agentic-software/ng-components/button": ["./libs/ng-components/button/src/index.ts"],
      "@agentic-software/ng-components/badge": ["./libs/ng-components/badge/src/index.ts"],
      "@agentic-software/ng-components/card": ["./libs/ng-components/card/src/index.ts"],
      "@agentic-software/ng-components/label": ["./libs/ng-components/label/src/index.ts"],
      "@agentic-software/ng-components/input": ["./libs/ng-components/input/src/index.ts"],
      "@agentic-software/ng-components/textarea": ["./libs/ng-components/textarea/src/index.ts"],
      "@agentic-software/ng-components/checkbox": ["./libs/ng-components/checkbox/src/index.ts"],
      "@agentic-software/ng-components/radio-group": ["./libs/ng-components/radio-group/src/index.ts"],
      "@agentic-software/ng-components/select": ["./libs/ng-components/select/src/index.ts"],
      "@agentic-software/ng-components/form-field": ["./libs/ng-components/form-field/src/index.ts"],
      "@agentic-software/ng-components/dialog": ["./libs/ng-components/dialog/src/index.ts"],
      "@agentic-software/ng-components/dropdown-menu": ["./libs/ng-components/dropdown-menu/src/index.ts"],
      "@agentic-software/ng-components/tooltip": ["./libs/ng-components/tooltip/src/index.ts"],
      "@agentic-software/ng-components/toast": ["./libs/ng-components/toast/src/index.ts"],
      "@agentic-software/ng-components/tabs": ["./libs/ng-components/tabs/src/index.ts"],
      "@agentic-software/ng-components/accordion": ["./libs/ng-components/accordion/src/index.ts"]
    },
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "esModuleInterop": false,
    "ignoreDeprecations": "6.0"
  },
  "exclude": ["node_modules", "tmp"]
}
