import { expect, test } from '@playwright/test';
import { gotoHydrated } from '../support/hydration';

/**
 * Functional/keyboard coverage for the ngc-<%= fileName %> demo page.
 * Stamped by the ngc-component generator – extend during the component's
 * wave (the manifest sweep already covers rendering + console errors).
 */
test.describe('<%= fileName %>', () => {
  test.beforeEach(async ({ page }) => {
    await gotoHydrated(page, '/components/<%= fileName %>');
  });

  test('shows the basic example', async ({ page }) => {
    await expect(page.locator('#<%= fileName %>-basic')).toBeVisible();
  });
});
