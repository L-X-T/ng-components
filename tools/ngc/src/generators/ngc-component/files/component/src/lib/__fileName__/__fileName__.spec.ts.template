import { Component } from '@angular/core';
import { TestBed } from '@angular/core/testing';
import { <%= className %> } from './<%= fileName %>';

@Component({
  imports: [<%= className %>],
  template: `<<%= selector %>>content</<%= selector %>>`,
})
class Host {}

describe('<%= className %>', () => {
  it('applies the base and default variant host classes', () => {
    const fixture = TestBed.createComponent(Host);
    fixture.detectChanges();
    const element = fixture.nativeElement.querySelector('<%= selector %>') as HTMLElement;

    expect(element.classList).toContain('ngc-<%= fileName %>');
    expect(element.classList).toContain('ngc-<%= fileName %>--default');
  });
});
