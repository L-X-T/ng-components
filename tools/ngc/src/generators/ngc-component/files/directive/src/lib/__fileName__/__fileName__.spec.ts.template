import { Component } from '@angular/core';
import { TestBed } from '@angular/core/testing';
import { Ngc<%= className %> } from './<%= fileName %>';

@Component({
  imports: [Ngc<%= className %>],
  template: `<button <%= attr %>>label</button>`,
})
class Host {}

describe('Ngc<%= className %>', () => {
  it('applies the base, variant and size host classes', () => {
    const fixture = TestBed.createComponent(Host);
    fixture.detectChanges();
    const element = fixture.nativeElement.querySelector('button') as HTMLElement;

    expect(element.classList).toContain('ngc-<%= fileName %>');
    expect(element.classList).toContain('ngc-<%= fileName %>--default');
  });
});
