{
  "name": "ng-components-demo",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/ng-components-demo/src",
  "tags": ["type:app"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production", { "externalDependencies": ["typescript"] }],
      "options": {
        "command": "tsc --noEmit -p tsconfig.app.json",
        "cwd": "apps/ng-components-demo"
      }
    },
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["^build", "ng-component-demos:generate-snippets"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/ng-components-demo",
        "browser": "apps/ng-components-demo/src/main.ts",
        "tsConfig": "apps/ng-components-demo/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/ng-components-demo/public"
          }
        ],
        "styles": ["apps/ng-components-demo/src/styles.scss"],
        "server": "apps/ng-components-demo/src/main.server.ts",
        "outputMode": "static"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "dependsOn": ["ng-component-demos:generate-snippets"],
      "defaultConfiguration": "development",
      "options": {
        "port": 6800
      },
      "configurations": {
        "production": {
          "buildTarget": "ng-components-demo:build:production"
        },
        "development": {
          "buildTarget": "ng-components-demo:build:development"
        }
      },
      "readyWhen": {
        "signal": true
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "ng-components-demo:build",
        "port": 6800,
        "staticFilePath": "dist/apps/ng-components-demo/browser",
        "spa": true
      }
    }
  }
}
