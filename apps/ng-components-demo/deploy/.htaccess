# designsystem.angular.st – Apache config for the prerendered static demo app
# (spec 003). Deployed to the All-Inkl webroot of the subdomain next to the
# static output.

# MultiViews content negotiation fights clean URLs; directory listings stay off.
Options -MultiViews -Indexes

# Redirects
<IfModule mod_rewrite.c>
	RewriteEngine On

	# Canonical host + HTTPS in one hop. Redirects to the literal host – the
	# Host header is client input and must not be echoed into the target.
	RewriteCond %{HTTPS} =off [OR]
	RewriteCond %{HTTP_HOST} !^designsystem\.angular\.st$ [NC]
	RewriteRule ^(.*)$ https://designsystem.angular.st/$1 [R=301,L]

	# Clean URLs: serve the prerendered index.html directly – no trailing-slash
	# redirect hop.
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
	RewriteRule ^(.*?)/?$ /$1/index.html [L]
</IfModule>

# Prevent mod_dir's own trailing-slash redirect; the rewrite above handles it.
<IfModule mod_dir.c>
	DirectorySlash Off
	DirectoryIndex index.html
</IfModule>

# 404: the app has no not-found page – its router sends unknown paths to the
# home page, so the home document is served (with the 404 status).
ErrorDocument 404 /index.html

# Caching: hashed build assets effectively forever, documents always
# revalidated, images (unhashed, from public/) for a day.
<IfModule mod_headers.c>
	<FilesMatch "\.(js|mjs|css|woff2?)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
	<FilesMatch "\.(html|xml|txt|webmanifest)$">
		Header set Cache-Control "no-cache"
	</FilesMatch>
	<FilesMatch "\.(png|jpe?g|gif|webp|avif|svg|ico)$">
		Header set Cache-Control "public, max-age=86400"
	</FilesMatch>

	# Security headers, same set as the company sites. The demo never needs
	# framing, powerful browser APIs, or MIME sniffing.
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Content-Security-Policy "frame-ancestors 'none'"
	Header always set X-Frame-Options "DENY"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

	# HSTS: one day, no subdomains, no preload – same starting point as
	# angular.st. <If> rather than env=HTTPS: mod_ssl sets HTTPS after
	# mod_rewrite's redirects run.
	<If "%{HTTPS} == 'on'">
		Header always set Strict-Transport-Security "max-age=86400"
	</If>
</IfModule>

# Deny access to following files
<FilesMatch "^\.htaccess$">
	Require all denied
</FilesMatch>
